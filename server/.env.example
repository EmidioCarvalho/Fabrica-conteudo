# ==============================================================================
# FÁBRICA DE CONTEÚDO - BACKEND API .ENV.EXAMPLE
# ==============================================================================

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Banco de Dados
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/fabrica?schema=public

# Autenticação JWT
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_min_32_chars
JWT_REFRESH_SECRET=seu_jwt_refresh_secret_super_seguro_aqui_min_32_chars

# Integração N8N
N8N_WEBHOOK_URL=http://localhost:5678/webhook/fabrica-publish
N8N_SHARED_SECRET=token_secreto_compartilhado_entre_api_e_n8n
PLATFORM_CALLBACK_URL=http://localhost:4000/api/webhooks/n8n/callback

# Storage / Uploads
UPLOAD_DIR=../public/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fabrica de Conteudo <noreply@fabrica.com>
RESEND_API_KEY=
