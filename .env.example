# ==============================================================================
# FÁBRICA DE CONTEÚDO - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# ==============================================================================

# ── AMBIENTE E SERVIDOR ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── BANCO DE DADOS POSTGRESQL ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=fabrica
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/fabrica?schema=public

# ── AUTENTICAÇÃO E SEGURANÇA (JWT) ────────────────────────────────────────────
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_min_32_chars
JWT_REFRESH_SECRET=seu_jwt_refresh_secret_super_seguro_aqui_min_32_chars

# ── ORQUESTRAÇÃO N8N (WORKFLOW PUBLISH) ───────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/fabrica-publish
N8N_SHARED_SECRET=token_secreto_compartilhado_entre_api_e_n8n
PLATFORM_CALLBACK_URL=http://localhost:4000/api/webhooks/n8n/callback

# ── INTELIGÊNCIA ARTIFICIAL E PESQUISA ────────────────────────────────────────
OPENAI_API_KEY=sua_chave_openai_aqui
SERPAPI_API_KEY=sua_chave_serpapi_aqui

# ── HOSPEDAGEM DE MÍDIA E IMAGENS ─────────────────────────────────────────────
IMGBB_API_KEY=sua_chave_imgbb_aqui
# Opcional se desejar utilizar Cloudinary em vez de storage local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── E-MAIL TRANSACIONAL (OPCIONAL) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fabrica de Conteudo <noreply@fabrica.com>
RESEND_API_KEY=

# ── REDES SOCIAIS E NOTIFICAÇÕES (N8N) ───────────────────────────────────────
APPROVAL_EMAIL=aprovacao@fabrica.com
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
LINKEDIN_ORG_ID=
EVOLUTION_INSTANCE=fabrica_notify
EVOLUTION_NOTIFY_JID=
